<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <NoWarn>$(NoWarn);CA1510;IDE0130;IDE0290;IDE0305</NoWarn>
        <HotReloadAutoRestart>true</HotReloadAutoRestart>
    </PropertyGroup>

    <!--
        Apple Silicon: Smartstore.LightningCss.Native ships no osx-arm64 CLI.
        Build against the osx-x64 CLI (runs via Rosetta) and also place it where the
        arm64 runtime looks for it (runtimes/osx-arm64/native, see RuntimeInfo).
    -->
    <PropertyGroup>
        <IsAppleSiliconHost Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">true</IsAppleSiliconHost>
        <SmartstoreLightningCssRid Condition="'$(IsAppleSiliconHost)' == 'true' And '$(RuntimeIdentifier)' == ''">osx-x64</SmartstoreLightningCssRid>
    </PropertyGroup>

    <ItemGroup Condition="'$(SmartstoreLightningCssRid)' == 'osx-x64' And '$(IsAppleSiliconHost)' == 'true' And '$(MSBuildProjectName)' == 'Smartstore.Web'">
        <None Include="$(NuGetPackageRoot)smartstore.lightningcss.native/1.33.0.1/tools/osx-x64/lightningcss"
              Condition="Exists('$(NuGetPackageRoot)smartstore.lightningcss.native/1.33.0.1/tools/osx-x64/lightningcss')"
              TargetPath="runtimes/osx-arm64/native/lightningcss"
              CopyToOutputDirectory="PreserveNewest"
              Visible="false" />
    </ItemGroup>

    <Target Name="MakeLightningCssArm64Executable"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition="'$(SmartstoreLightningCssRid)' == 'osx-x64' And '$(IsAppleSiliconHost)' == 'true' And '$(MSBuildProjectName)' == 'Smartstore.Web'">
        <Exec Command="chmod +x &quot;$(TargetDir)runtimes/osx-arm64/native/lightningcss&quot;"
              Condition="Exists('$(TargetDir)runtimes/osx-arm64/native/lightningcss')" />
    </Target>
</Project>
